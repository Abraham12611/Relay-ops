# Planned local-only environment example. The business API is not yet implemented.
DATABASE_URL="file:./relayops.db"
DEMO_MODE="true"
DEMO_OPERATOR_KEY="replace-with-local-secret"
APP_BASE_URL="http://localhost:3000"
# This origin must be reachable from the Switch agent runtime; do not assume localhost crosses containers/hosts.
RELAYOPS_API_BASE_URL="http://localhost:3000"
# Set only after E04 confirms the required request-ID header name; writes otherwise fail closed.
RELAYOPS_REQUEST_ID_HEADER=""
AGENT_READ_API_KEY="replace-with-read-only-secret"
AGENT_PROPOSE_API_KEY="replace-with-proposal-secret"
AGENT_EXECUTE_API_KEY="replace-with-execute-secret"
# Switch/Mattermost settings must follow official docs for the installed Console release.
