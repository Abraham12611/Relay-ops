# Prisma SQLite resolves this file URL relative to prisma/schema.prisma (the parent is the repo root).
DATABASE_URL="file:../relayops.db"
DEMO_MODE="true"
# Replace each placeholder with a distinct random value of at least 24 characters.
DEMO_OPERATOR_KEY="replace-with-a-random-operator-secret"
AGENT_READ_API_KEY="replace-with-a-distinct-agent-read-secret"
AGENT_PROPOSE_API_KEY="replace-with-a-distinct-agent-propose-secret"
AGENT_EXECUTE_API_KEY="replace-with-a-distinct-agent-execute-secret"
APP_BASE_URL="http://localhost:3000"
# Switch/Mattermost connection parameters must match official docs and actual installed version.
