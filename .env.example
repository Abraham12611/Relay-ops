# Prisma resolves this path relative to prisma/schema.prisma; this stores the DB at the repo root.
DATABASE_URL="file:../relayops.db"
DEMO_MODE="true"
# Replace each placeholder with a distinct random value of at least 24 characters.
DEMO_OPERATOR_KEY="replace-with-a-random-operator-secret"
AGENT_READ_API_KEY="replace-with-a-distinct-agent-read-secret"
AGENT_PROPOSE_API_KEY="replace-with-a-distinct-agent-propose-secret"
AGENT_EXECUTE_API_KEY="replace-with-a-distinct-agent-execute-secret"
APP_BASE_URL="http://localhost:3000"
# This origin must be reachable from the Switch agent runtime; do not assume localhost crosses containers/hosts.
RELAYOPS_API_BASE_URL="http://localhost:3000"
# The app accepts and returns correlation IDs through this request header.
RELAYOPS_REQUEST_ID_HEADER="x-request-id"
# Switch/Mattermost settings must follow official docs for the installed Console release.
