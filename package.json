{
  "name": "relay-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "prisma generate && next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "prisma generate && next start --hostname 0.0.0.0",
    "test": "prisma generate && cross-env DATABASE_URL=file:../relayops-test.db prisma migrate deploy && cross-env DATABASE_URL=file:../relayops-test.db node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:integration:expiry": "cross-env RELAYOPS_RUN_EXPIRY_INTEGRATION_TESTS=1 node scripts/run-integration-tests.mjs",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "seed": "prisma generate && prisma migrate deploy && prisma db seed",
    "reset:demo": "prisma generate && prisma migrate deploy && tsx scripts/reset-demo.ts",
    "reset:service": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/reset-demo.mjs",
    "smoke": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/golden-path-smoke.mjs",
    "smoke:foundation": "prisma generate && tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "next": "^15.5.29",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "deepmerge-ts": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.0.0",
    "dotenv": "^16.6.1",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
